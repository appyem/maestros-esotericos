rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Funciones auxiliares de rol
    function isAdmin() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['ADMINISTRATOR', 'SUPER_ADMIN'];
    }
    
    function isSuperAdmin() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SUPER_ADMIN';
    }

    // ==========================================
    // AUDITORÍA AVANZADA (Audit Logs) - F13/F14
    // ==========================================
    match /auditLogs/{logId} {
      // NADIE puede leer o escribir logs de auditoría desde el cliente.
      // Solo el backend (Firebase Admin SDK) tiene acceso total.
      allow read, write: if false;
    }

    // ==========================================
    // ALERTAS DE SEGURIDAD (Security Alerts) - F14
    // ==========================================
    match /securityAlerts/{alertId} {
      allow read: if isSuperAdmin();
      allow write: if false; // Solo backend
    }

    // ==========================================
    // CONFIGURACIÓN GLOBAL (Global Settings) - F14
    // ==========================================
    match /globalSettings/{settingId} {
      allow read: if isAdmin();
      allow write: if false; // Solo backend
    }

    // ==========================================
    // INCIDENCIAS (Incidents) - F13/F14
    // ==========================================
    match /incidents/{incidentId} {
      allow read: if isAdmin();
      allow write: if false; // Solo backend
    }

    // ==========================================
    // CONSULTAS Y MENSAJES - F10
    // ==========================================
    match /consultations/{consultationId} {
      allow read: if request.auth != null && (
        resource.data.clientUserId == request.auth.uid || 
        resource.data.masterId == request.auth.uid ||
        isAdmin()
      );
      allow write: if false; // Solo backend
    }

    match /consultationContexts/{contextId} {
      allow read: if request.auth != null && 
        exists(/databases/$(database)/documents/consultations/$(resource.data.consultationId)) &&
        (get(/databases/$(database)/documents/consultations/$(resource.data.consultationId)).data.masterId == request.auth.uid || isAdmin());
      allow write: if false; // Solo backend
    }

    match /consultationMessages/{messageId} {
      allow read: if request.auth != null && 
        exists(/databases/$(database)/documents/consultations/$(resource.data.consultationId)) &&
        (get(/databases/$(database)/documents/consultations/$(resource.data.consultationId)).data.clientUserId == request.auth.uid ||
         get(/databases/$(database)/documents/consultations/$(resource.data.consultationId)).data.masterId == request.auth.uid ||
         isAdmin());
      allow write: if false; // Solo backend
    }

    // ==========================================
    // NOTIFICACIONES - F11
    // ==========================================
    match /notifications/{notificationId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false; // Solo backend
    }

    match /notificationPreferences/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /communicationConsents/{consentId} {
      allow read, write: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // ==========================================
    // TIENDA (Products, Categories, Orders, Carts) - F12
    // ==========================================
    match /products/{productId} {
      allow read: if resource.data.status == 'ACTIVE';
      allow write: if false; // Solo backend
    }

    match /categories/{categoryId} {
      allow read: if resource.data.status == 'ACTIVE';
      allow write: if false; // Solo backend
    }

    match /carts/{cartId} {
      allow read, write: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /orders/{orderId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false; // Solo backend
    }

    // ==========================================
    // PAGOS - F9
    // ==========================================
    match /payments/{paymentId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false; // Solo backend
    }

    // ==========================================
    // USUARIOS - F3/F7/F14
    // ==========================================
    match /users/{userId} {
      // Un usuario puede leer su propio perfil. Admins pueden leer todos.
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      
      // PROTECCIÓN CRÍTICA: NUNCA permitir que un cliente se escriba a sí mismo para cambiar su rol.
      // La escritura de usuarios (cambios de rol, permisos, estado) SOLO se permite desde el backend (Admin SDK).
      allow write: if false; 
    }
  }
}
