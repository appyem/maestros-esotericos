rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // FUNCIONES AUXILIARES
    // ==========================================
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }
    
    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.superAdmin == true;
    }

    // ==========================================
    // REGLA GLOBAL: DENEGAR POR DEFECTO
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // COLECCIONES PÚBLICAS
    // ==========================================
    match /public_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() || isSuperAdmin();
    }

    // ==========================================
    // COLECCIÓN DE USUARIOS
    // ==========================================
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() || isSuperAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId
                    && (request.resource.data.role == 'CLIENTE' || request.resource.data.role == 'PUBLIC');
      allow update: if (isOwner(userId) 
                       && request.resource.data.role == resource.data.role
                       && request.resource.data.status == resource.data.status
                       && request.resource.data.isAnonymous == resource.data.isAnonymous)
                    || isAdmin() 
                    || isSuperAdmin();
      allow delete: if isAdmin() || isSuperAdmin();
    }

    // ==========================================
    // CONVERSACIONES (Ownership estricto)
    // ==========================================
    match /conversations/{conversationId} {
      allow read, write: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
    }

    // ==========================================
    // MENSAJES (Ownership estricto, inmutabilidad de campos clave)
    // ==========================================
    match /messages/{messageId} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.userId;
      
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId
                    && request.resource.data.keys().hasOnly(['conversationId', 'userId', 'senderType', 'content', 'createdAt', 'status', 'metadata']);
                    
      // No se permite update ni delete para mantener la inmutabilidad del historial (soft delete se manejará vía status si es necesario, pero por ahora denegamos)
      allow update, delete: if false; 
    }

    // ==========================================
    // MEMORIA DE IA (Ownership estricto)
    // ==========================================
    match /aiMemory/{memoryId} {
      allow read, write: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
    }

    // ==========================================
    // RESÚMENES DE IA (Ownership estricto)
    // ==========================================
    match /aiSummaries/{summaryId} {
      allow read, write: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
    }

    // ==========================================
    // COLECCIÓN DE AUDITORÍA
    // ==========================================
    match /auditLogs/{logId} {
      allow read: if isAdmin() || isSuperAdmin();
      allow write: if false;
    }
  }
}
