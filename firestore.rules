rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // FUNCIONES AUXILIARES DE SEGURIDAD
    // ==========================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['ADMINISTRATOR', 'SUPER_ADMIN'];
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SUPER_ADMIN';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ==========================================
    // 1. AUDITORÍA Y SEGURIDAD (BLOQUEO TOTAL AL CLIENTE)
    // ==========================================
    match /auditLogs/{logId} {
      allow read, write: if false; // Solo Backend (Admin SDK)
    }
    
    match /analyticsEvents/{eventId} {
      allow read, write: if false; // Solo Backend
    }
    
    match /dailyAnalyticsAggregations/{date} {
      allow read: if isAdmin();
      allow write: if false; // Solo Backend (Jobs)
    }
    
    match /securityAlerts/{alertId} {
      allow read: if isSuperAdmin();
      allow write: if false; // Solo Backend
    }

    // ==========================================
    // 2. CONFIGURACIÓN Y SISTEMA
    // ==========================================
    match /globalSettings/{settingId} {
      allow read: if isAdmin();
      allow write: if false; // Solo Backend
    }
    
    match /incidents/{incidentId} {
      allow read: if isAdmin();
      allow write: if false; // Solo Backend
    }

    // ==========================================
    // 3. USUARIOS Y ROLES (ANTI-ESCALADA)
    // ==========================================
    match /users/{userId} {
      // Lectura: propio o administradores
      allow read: if isOwner(userId) || isAdmin();
      // Escritura: BLOQUEADA AL CLIENTE. Los cambios de rol/estado SOLO los hace el Backend.
      allow write: if false; 
    }

    // ==========================================
    // 4. CONSULTAS Y CONTEXTO (F10)
    // ==========================================
    match /consultations/{consultationId} {
      allow read: if isAuthenticated() && (
        resource.data.clientUserId == request.auth.uid || 
        resource.data.masterId == request.auth.uid ||
        isAdmin()
      );
      allow write: if false; // Solo Backend
    }

    match /consultationContexts/{contextId} {
      allow read: if isAuthenticated() && 
        exists(/databases/$(database)/documents/consultations/$(resource.data.consultationId)) &&
        (get(/databases/$(database)/documents/consultations/$(resource.data.consultationId)).data.masterId == request.auth.uid || isAdmin());
      allow write: if false; // Solo Backend
    }

    match /consultationMessages/{messageId} {
      allow read: if isAuthenticated() && 
        exists(/databases/$(database)/documents/consultations/$(resource.data.consultationId)) &&
        (get(/databases/$(database)/documents/consultations/$(resource.data.consultationId)).data.clientUserId == request.auth.uid ||
         get(/databases/$(database)/documents/consultations/$(resource.data.consultationId)).data.masterId == request.auth.uid ||
         isAdmin());
      allow write: if false; // Solo Backend
    }

    // ==========================================
    // 5. NOTIFICACIONES (F11)
    // ==========================================
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false; // Solo Backend
    }

    match /notificationPreferences/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /communicationConsents/{consentId} {
      allow read, write: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ==========================================
    // 6. TIENDA E INVENTARIO (F12)
    // ==========================================
    match /products/{productId} {
      allow read: if resource.data.status == 'ACTIVE'; // Público solo si está activo
      allow write: if false; // Solo Backend
    }

    match /categories/{categoryId} {
      allow read: if resource.data.status == 'ACTIVE';
      allow write: if false; // Solo Backend
    }

    match /carts/{cartId} {
      allow read, write: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /orders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false; // Solo Backend
    }

    // ==========================================
    // 7. PAGOS (F9)
    // ==========================================
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false; // Solo Backend
    }
  }
}
