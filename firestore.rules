rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // FUNCIONES AUXILIARES
    // ==========================================
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }
    
    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.superAdmin == true;
    }

    // ==========================================
    // REGLA GLOBAL: DENEGAR POR DEFECTO
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // COLECCIONES PÚBLICAS
    // ==========================================
    match /public_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() || isSuperAdmin();
    }

    // ==========================================
    // COLECCIÓN DE USUARIOS (PROTEGIDA CONTRA ESCALAMIENTO)
    // ==========================================
    match /users/{userId} {
      // Lectura: Solo el dueño o administradores
      allow read: if isOwner(userId) || isAdmin() || isSuperAdmin();
      
      // Creación: El usuario solo puede crear su propio documento. 
      // Se fuerza que el rol inicial sea CLIENTE o PUBLIC (nunca ADMIN/SUPER_ADMIN)
      allow create: if isSignedIn() && request.auth.uid == userId
                    && (request.resource.data.role == 'CLIENTE' || request.resource.data.role == 'PUBLIC');
      
      // Actualización: El dueño puede actualizar, PERO no puede modificar campos sensibles.
      // La regla verifica que el valor nuevo (request.resource.data) sea IGUAL al valor actual (resource.data)
      // para los campos críticos. Admins/SuperAdmins sí pueden modificarlos.
      allow update: if (isOwner(userId) 
                       && request.resource.data.role == resource.data.role
                       && request.resource.data.status == resource.data.status
                       && request.resource.data.isAnonymous == resource.data.isAnonymous)
                    || isAdmin() 
                    || isSuperAdmin();
      
      // Eliminación: Solo administradores (para evitar que un usuario borre su propio registro y cause inconsistencias)
      allow delete: if isAdmin() || isSuperAdmin();
    }

    // ==========================================
    // COLECCIÓN DE AUDITORÍA
    // ==========================================
    match /auditLogs/{logId} {
      allow read: if isAdmin() || isSuperAdmin();
      allow write: if false; // Solo el backend (Cloud Functions) puede escribir aquí
    }

    // ==========================================
    // COLECCIÓN DE SESIONES DE IA
    // ==========================================
    match /aiSessions/{sessionId} {
      allow read, write: if isSignedIn() && request.auth.uid == resource.data.userId;
    }
  }
}
