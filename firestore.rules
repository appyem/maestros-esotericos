rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // CONSULTAS (Consultations)
    // ==========================================
    match /consultations/{consultationId} {
      // Solo el cliente o el maestro asignado pueden leer
      allow read: if request.auth != null && (
        resource.data.clientUserId == request.auth.uid || 
        resource.data.masterId == request.auth.uid
      );
      
      // La creación y actualización de consultas SOLO se permite desde el backend (Admin SDK)
      // Denegamos escritura directa desde el cliente para prevenir manipulación de estados o pagos.
      allow write: if false; 
    }

    // ==========================================
    // CONTEXTOS DE CONSULTA (Consultation Contexts)
    // ==========================================
    match /consultationContexts/{contextId} {
      // Solo el maestro asignado a esa consulta puede leer el contexto
      allow read: if request.auth != null && 
        exists(/databases/$(database)/documents/consultations/$(resource.data.consultationId)) &&
        get(/databases/$(database)/documents/consultations/$(resource.data.consultationId)).data.masterId == request.auth.uid;
      
      // Escritura solo desde backend
      allow write: if false;
    }

    // ==========================================
    // MENSAJES DE CONSULTA (Consultation Messages)
    // ==========================================
    match /consultationMessages/{messageId} {
      // Solo el cliente o el maestro de esa consulta pueden leer los mensajes
      allow read: if request.auth != null && 
        exists(/databases/$(database)/documents/consultations/$(resource.data.consultationId)) &&
        (
          get(/databases/$(database)/documents/consultations/$(resource.data.consultationId)).data.clientUserId == request.auth.uid ||
          get(/databases/$(database)/documents/consultations/$(resource.data.consultationId)).data.masterId == request.auth.uid
        );
      
      // Escritura solo desde backend (la API valida el rol y el token)
      allow write: if false;
    }

    // ==========================================
    // PAGOS (Payments) - De la Fase 9
    // ==========================================
    match /payments/{paymentId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // ==========================================
    // CITAS (Appointments) - De la Fase 8
    // ==========================================
    match /appointments/{appointmentId} {
      allow read: if request.auth != null && (
        resource.data.clientUserId == request.auth.uid || 
        resource.data.masterId == request.auth.uid
      );
      allow write: if false; // Solo backend
    }

    // ==========================================
    // USUARIOS (Users)
    // ==========================================
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // Solo backend
    }
  }
}
