rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // FUNCIONES AUXILIARES DE AUTORIZACIÓN
    // ==========================================
    
    // Verifica si el usuario está autenticado
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Verifica si el usuario es el dueño del recurso
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // Verifica si el usuario tiene rol de Administrador (Custom Claim)
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }
    
    // Verifica si el usuario tiene rol de Super Admin (Custom Claim)
    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.superAdmin == true;
    }
    
    // Verifica si el usuario es un Maestro asignado (Custom Claim o campo en doc)
    function isAssignedMaster(masterId) {
      return isSignedIn() && (request.auth.uid == masterId || request.auth.token.master == true);
    }

    // ==========================================
    // REGLA GLOBAL: DENEGAR POR DEFECTO
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // COLECCIONES PÚBLICAS (Acceso de lectura para todos)
    // ==========================================
    match /public_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() || isSuperAdmin();
    }

    // ==========================================
    // COLECCIÓN DE USUARIOS (Perfiles)
    // ==========================================
    match /users/{userId} {
      // Un usuario solo puede leer su propio perfil. Admins pueden leer todos.
      allow read: if isOwner(userId) || isAdmin() || isSuperAdmin();
      
      // Un usuario solo puede crear su propio perfil (y solo con su UID)
      allow create: if isSignedIn() && request.auth.uid == userId;
      
      // Un usuario solo puede actualizar sus propios datos (no puede elevar sus propios privilegios)
      allow update: if isOwner(userId) && 
                    request.resource.data.keys().hasOnly(['name', 'alias', 'updatedAt']) &&
                    request.resource.data.name == resource.data.name; // Simplificado para FASE 2
      
      // Solo Admin o Super Admin pueden eliminar usuarios
      allow delete: if isAdmin() || isSuperAdmin();
    }

    // ==========================================
    // COLECCIÓN DE AUDITORÍA (Audit Logs)
    // ==========================================
    match /auditLogs/{logId} {
      // Nadie puede leer logs desde el cliente (solo backend/admin)
      allow read: if isAdmin() || isSuperAdmin();
      
      // Los clientes NO pueden escribir directamente en los logs de auditoría.
      // Esto se hará exclusivamente desde Cloud Functions (Backend).
      allow write: if false; 
    }

    // ==========================================
    // COLECCIÓN DE SESIONES DE IA (Preparado para FASE 5/6)
    // ==========================================
    match /aiSessions/{sessionId} {
      // Solo el dueño de la sesión o un admin puede acceder
      allow read, write: if isOwner(resource.data.userId) || isAdmin() || isSuperAdmin();
    }
  }
}
