# ==========================================
# VARIABLES DE ENTORNO DE LA APLICACIÓN
# ==========================================

# Next.js (Público)
NEXT_PUBLIC_APP_NAME="Maestros Esotéricos"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Firebase (Público - Cliente)
NEXT_PUBLIC_FIREBASE_API_KEY="tu-api-key-aqui"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="tu-proyecto.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="tu-proyecto-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="tu-proyecto.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="tu-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="tu-app-id"

# Firebase Emulators (Solo Desarrollo Local)
# Descomentar para usar emuladores en lugar de producción
# NEXT_PUBLIC_FIREBASE_EMULATOR_HOST="127.0.0.1:8080"
# FIREBASE_STORAGE_EMULATOR_HOST="127.0.0.1:9199"
# FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"

# Firebase Admin (SOLO BACKEND / SERVER-SIDE - NUNCA EN FRONTEND)
# FIREBASE_ADMIN_PROJECT_ID="tu-proyecto-id"
# FIREBASE_ADMIN_CLIENT_EMAIL="tu-service-account@tu-proyecto.iam.gserviceaccount.com"
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
