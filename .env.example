# ==========================================
# VARIABLES DE ENTORNO DE LA APLICACIÓN
# ==========================================

# Next.js (Público)
NEXT_PUBLIC_APP_NAME="Maestros Esotéricos"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Firebase (Público - Cliente)
NEXT_PUBLIC_FIREBASE_API_KEY="TU_API_KEY_DE_EJEMPLO_AQUI"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="TU_PROYECTO.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="TU_PROYECTO_ID_AQUI"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="TU_PROYECTO.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="TU_SENDER_ID_AQUI"
NEXT_PUBLIC_FIREBASE_APP_ID="TU_APP_ID_AQUI"

# Firebase Emulators (Solo Desarrollo Local)
# NEXT_PUBLIC_FIREBASE_EMULATOR_HOST="127.0.0.1:8080"
# FIREBASE_STORAGE_EMULATOR_HOST="127.0.0.1:9199"
# FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"

# Firebase Admin (SOLO BACKEND / SERVER-SIDE - NUNCA EN FRONTEND)
# FIREBASE_ADMIN_PROJECT_ID="TU_PROYECTO_ID_AQUI"
# FIREBASE_ADMIN_CLIENT_EMAIL="TU_CORREO_DE_EJEMPLO@ejemplo.com"
# FIREBASE_ADMIN_PRIVATE_KEY="TU_CLAVE_PRIVADA_DE_EJEMPLO_AQUI"

# ==========================================
# GROQ AI (SOLO BACKEND / SERVER-SIDE)
# ==========================================
GROQ_API_KEY="TU_CLAVE_DE_EJEMPLO_AQUI"
GROQ_MODEL="openai/gpt-oss-20b"
