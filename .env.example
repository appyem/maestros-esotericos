# ==========================================
# VARIABLES DE ENTORNO DE LA APLICACIÓN
# ==========================================
# Copia este archivo a .env.local y rellena los valores.
# NUNCA commitees el archivo .env.local al repositorio.

# Next.js (Público, prefijo NEXT_PUBLIC_)
NEXT_PUBLIC_APP_NAME="Maestros Esotéricos"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Firebase (Se configurarán en FASE 2)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (Solo Backend/Cloud Functions - NUNCA en frontend)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Proveedores de IA (Solo Backend)
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=

# Proveedores de Pago (Solo Backend)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# WhatsApp Business API (Solo Backend)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
